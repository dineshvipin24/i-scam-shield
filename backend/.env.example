# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── Server URL (ngrok URL when testing locally) ──────────────────────────────
# Example: https://abc123.ngrok.io
SERVER_URL=https://your-ngrok-url.ngrok.io

# ─── Call Forwarding (user's real phone number) ───────────────────────────────
FORWARD_TO_NUMBER=+91xxxxxxxxxx

# ─── Speech-to-Text ───────────────────────────────────────────────────────────
# Options: "deepgram" | "whisper"
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ─── Database ─────────────────────────────────────────────────────────────────
# Leave default for SQLite, or use postgresql://user:pass@host/dbname for prod
DB_PATH=./scam_shield.db
