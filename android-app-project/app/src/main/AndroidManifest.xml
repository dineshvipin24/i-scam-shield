<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.campprotect.scamshield">

    <!-- Permissions required for Call Detection & States -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!-- Role declaration for Call Screening (Android 10+) -->
    <uses-permission android:name="android.permission.ROLE_CALL_SCREENING" />

    <!-- Permission required to show Alert Overlay over active call screens -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Permissions required for Speech-to-Text via Microphone -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- Foreground Service permissions for background recording (Android 14+ compliance) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Permission for Fraud Alert Sound/Vibration alerts -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Notification permission for foreground alerts (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CampProtect">

        <!-- Main Launcher Activity (Prominent Disclosure and Consent Flow starts here) -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CampProtect">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings Screen Activity -->
        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Call Screening Service to intercept incoming calls and trigger analysis -->
        <service
            android:name=".services.CallScreeningServiceImpl"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Foreground Service that manages microphone recording, STT listener and evaluations (API 34 compliance) -->
        <service
            android:name=".services.CallMonitoringForegroundService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!-- Alert Overlay Service for drawing warning popups on top of call screens -->
        <service
            android:name=".overlay.AlertOverlayService"
            android:exported="false" />

    </application>
</manifest>
